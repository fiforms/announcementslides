# Copy to docker/.env and edit. Never commit the real file.

# Required. Generate with:
#   docker run --rm ghcr.io/fiforms/announcementslides php artisan key:generate --show
# Keep a copy somewhere safe: a restore on another server needs the same key.
APP_KEY=

# Required. Pick a long random password.
DB_PASSWORD=

# Public URL people will use (used for links, and the Google OAuth redirect).
APP_URL=http://localhost:8080
APP_PORT=8080
APP_NAME=Announcement Slides

# Pin a release instead of :latest, e.g. ghcr.io/fiforms/announcementslides:1.2.0
# APP_IMAGE=ghcr.io/fiforms/announcementslides:latest

# Optional
# DB_DATABASE=announcementslides
# DB_USERNAME=announcementslides
# TRUSTED_PROXIES=*
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
