# Optional. Everything here is passed into the container as-is, and nothing is
# required: with no .env the app runs with the bundled MySQL at
# http://localhost:8080 and generates its own APP_KEY (stored in the storage volume).
# Copy to docker/.env to override.

# Public URL people will use (links, Google OAuth redirect).
# APP_URL=http://localhost:8080
# APP_PORT=8080
# APP_NAME=AnnouncementSlides

# Pin a release instead of :latest.
# APP_IMAGE=ghcr.io/fiforms/announcementslides:1.2.0

# Manage the key yourself instead of using the generated one.
#   docker run --rm ghcr.io/fiforms/announcementslides php artisan key:generate --show
# APP_KEY=

# Database. Set a real password for anything reachable from outside. To use an
# existing MySQL server, set DB_HOST too and run `docker compose up -d --no-deps app`.
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=announcementslides
# DB_USERNAME=announcementslides

# Behind a reverse proxy: the proxy's IP/CIDR (default trusts any).
# TRUSTED_PROXIES=*

# Mail
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# S3-compatible file storage instead of the volume
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=

# First-run setup wizard. While there are no users, opening the site goes to
# /setup, which creates the first admin and installs the bundled widgets.
# Empty = anyone who reaches the page first can create the admin (fine for a
# local test). Set a secret to require it on the form for anything exposed.
# SETUP_TOKEN=

# Show the email/password login form (default true here; set false for
# Google-only sign-in once GOOGLE_* is configured).
# PASSWORD_LOGIN=true
