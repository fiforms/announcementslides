# Branding for one customer of the slideannouncer product. Shell syntax,
# no spaces around the =. Copy this directory to brands/<name>/ and edit.
# Files beside this one:
#   splash.png   boot splash + first-run Welcome + Settings > About graphic
#                (use a black background; omit to keep the stock graphic)

# Pre-pairing hostname becomes <prefix>-NNNNNN. Letters, digits, hyphens.
HOSTNAME_PREFIX=examplescreen
