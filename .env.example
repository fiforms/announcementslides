APP_NAME=Announcement Slides
# Optional per-language site name shown in the web UI (falls back to APP_NAME)
# APP_NAME_es="Anuncios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Reverse proxy IPs/CIDRs (comma-separated) whose X-Forwarded-* headers are trusted; "*" = any
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: offload large media and Slide Announcer releases to Cloudflare R2
# (no egress fees). Unset = everything stays on this host. See config/media.php.
# MEDIA_OFFLOAD_DISK=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.example.org
# MEDIA_OFFLOAD_MIN_BYTES=1048576
# MEDIA_OFFLOAD_RELEASES=true
# MEDIA_RELEASES_WAIT_FOR_OFFLOAD=true
# MEDIA_CACHE_MAX_BYTES=2147483648
# MEDIA_CACHE_MIN_AGE=60
# MEDIA_TRASH_PREFIX=trash/        # deleted R2 files move here; purge with an R2 lifecycle rule

# Slides whose file is larger than this (bytes) are left out of ZIP downloads
# and listed in the archive instead. 0 = no limit. Default 10 MB.
# ZIP_MAX_MEDIA_BYTES=10485760
# REVELation downloads link (rather than embed) media larger than this; it
# downloads into the user's media library when opened. 0 = always embed.
# REVELATION_LINK_MEDIA_BYTES=10485760

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
